{
  "compilerOptions": {
    "lib": ["dom", "es2017"],
    "jsx": "react",
    "outDir": "./dist",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2017",
    "skipLibCheck": true
  },
  "include": ["src/**/*.tsx", "src/**/*.ts"]
}
