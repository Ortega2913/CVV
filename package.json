  "description": "Cinematic 30s faith-based vertical short built with Remotion + Three.js (the repentant thief on the cross — Luke 23:43).",
  "license": "MIT",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render Faith out/faith.mp4",
