    "still": "remotion still Faith out/frame.png --frame=80",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/motion-blur": "4.0.290",
    "@remotion/three": "4.0.290",
    "@react-three/fiber": "8.17.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.290",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "typescript": "5.5.4"
  }
}
